# 复制为 .env 后填入真实值
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=ep-1v02bui1

PEXELS_API_KEY=your_pexels_key_here

# TTS 后端：edge（云端，默认）或 piper（本地）
TTS_BACKEND=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 使用 piper 时填模型路径
# PIPER_MODEL_PATH=D:/models/piper/zh_CN-huayan-medium.onnx
PIPER_WHISPER_SIZE=base

# 可观测性：LangSmith（可选，填 key 后自动启用云端追踪）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clipforge
